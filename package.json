{
  "name": "@ugrc/plss-review",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "copy:arcgis": "cpy \"./node_modules/@arcgis/core/assets/**\" ./public/assets",
    "dev": "cross-env NODE_ENV=development NODE_OPTIONS=--no-deprecation concurrently 'wait-on http://127.0.0.1:4000 && ./scripts/seed.sh && pnpm run dev:vite' 'pnpm run dev:firebase' 'cd functions && pnpm run build:watch'",
    "dev:firebase": "cross-env NODE_ENV=development firebase emulators:start --import=.emulator-data --only auth,functions,firestore,storage,pubsub",
    "dev:firebase-state": "cross-env NODE_ENV=development concurrently 'firebase emulators:start --import=.emulator-data --export-on-exit=.emulator-data --only auth,functions,firestore,storage' 'pnpm run dev:vite'",
    "dev:vite": "vite",
    "dev-windows": "cross-env NODE_ENV=development NODE_OPTIONS=--no-deprecation concurrently \"wait-on http://127.0.0.1:4000 && bash .\\scripts\\seed.sh && pnpm run dev:vite\" \"pnpm run dev:firebase\" \"cd functions && pnpm run build:watch\"",
    "format": "prettier . --write",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "pnpm run dev",
    "start:ci": "vite --host",
    "start-win": "pnpm run dev-windows",
    "test": "vitest --silent --coverage --ui --open --passWithNoTests",
    "test:ci": "firebase emulators:exec --only storage,firestore 'vitest run --coverage'"
  },
  "browserslist": {
    "production": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@arcgis/core": "^4.34.8",
    "@heroicons/react": "^2.2.0",
    "@internationalized/date": "^3.12.4",
    "@tanstack/react-query": "^5.105.2",
    "@tanstack/react-query-devtools": "^5.105.2",
    "@tanstack/react-table": "^8.21.3",
    "@ugrc/eslint-config": "^1.3.1",
    "@ugrc/esri-theme-toggle": "^1.1.2",
    "@ugrc/utah-design-system": "^1.35.0",
    "@ugrc/utilities": "^3.1.1",
    "firebase": "^12.19.0",
    "ky": "^1.14.3",
    "lucide-react": "^1.66.0",
    "luxon": "^3.7.2",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-content-loader": "^7.1.2",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.91.0",
    "react-router": "^7.18.5",
    "react-stately": "^3.51.0",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tanstack/eslint-plugin-query": "^5.105.2",
    "@types/luxon": "^3.7.6",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@ugrc/tailwind-preset": "^1.2.0",
    "@ugrc/tsconfigs": "^1.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "firebase-functions-test": "^3.5.0",
    "firebase-tools": "^15.34.2",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "react-router-devtools": "^6.2.3",
    "tailwindcss": "^3.4.19",
    "tailwindcss-react-aria-components": "^1.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-package-version": "^1.1.0",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
